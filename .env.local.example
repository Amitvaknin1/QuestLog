# MongoDB connection string
# Get yours from https://cloud.mongodb.com (free tier available)
# Copy this file to .env.local and fill in your real values
# IMPORTANT: .env.local is in .gitignore — never commit real credentials

MONGODB_URI=mongodb+srv://questlog_user:YOUR_PASSWORD@questlog.xxxxx.mongodb.net/questlog?retryWrites=true&w=majority&appName=QuestLog

# Example format for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/questlog?retryWrites=true&w=majority
